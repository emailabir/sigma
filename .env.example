# Server-only credentials. For Wrangler development, copy to ignored .dev.vars.
# Never use a NEXT_PUBLIC_ or VITE_ prefix for these secrets.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
SIGMA_GITHUB_CLIENT_ID=
SIGMA_GITHUB_CLIENT_SECRET=
# Email login: a Brevo API key (not SMTP key) and a verified sender address.
# Set SIGMA_AUTH_MODE=email in ignored .dev.vars for local email testing.
SIGMA_BREVO_API_KEY=
SIGMA_EMAIL_FROM=
# Firebase WEB configuration is public (not an Admin SDK/service-account key).
# Runtime mode must be firebase after project/provider/domain setup is complete.
SIGMA_FIREBASE_PROJECT_ID=
SIGMA_FIREBASE_API_KEY=
